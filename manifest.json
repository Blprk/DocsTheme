{
  "manifest_version": 3,
  "name": "Google Docs Theme Switcher",
  "version": "1.0.0",
  "description": "Beautiful theme switching for Google Docs with canvas filtering support",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.google.com/docs/*",
    "https://*.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "https://*.google.com/docs/*",
        "https://*.google.com/document/*"
      ],
      "js": ["content/themeEngine.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Theme Switcher"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/themes/*.css"],
      "matches": ["https://docs.google.com/*"]
    },
    {
      "resources": ["content/themes/*.css"],
      "matches": ["https://*.google.com/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}